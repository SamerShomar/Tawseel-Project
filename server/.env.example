PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tawseel"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="http://localhost:5173"

# Email for "Forgot password". The first one that is set is used:
#   1. BREVO_API_KEY  (recommended, works on Railway; MAIL_FROM must be a sender verified in Brevo)
#   2. RESEND_API_KEY (needs your own verified domain to email other people)
#   3. SMTP_HOST ...  (Railway blocks SMTP on free/trial plans)
# With none of them set (development), the reset link is printed in the server console.
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tawseel <no-reply@tawseel.local>"

# Admin account (created/updated every time the server starts). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

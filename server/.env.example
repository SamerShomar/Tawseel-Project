PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tawseel"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_URL="http://localhost:5173"

# Email for "Forgot password". Leave SMTP_HOST empty in development:
# the reset link is then printed in the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tawseel <no-reply@tawseel.local>"

# Admin account (created/updated every time the server starts). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
